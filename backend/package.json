    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/swagger": "^7.4.2",
    "swagger-ui-express": "^5.0.1",
    "mongoose": "^8.24.4",
    "rxjs": "^7.8.2",
    "reflect-metadata": "^0.2.2",
    "class-validator": "^0.15.1",
    "class-transformer": "^0.5.1",
    "bull": "^4.16.5",
    "@nestjs/bull": "^10.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "ts-node": "^10.9.2"
