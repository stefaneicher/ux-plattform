{
  "name": "@css-insurance/backend",
  "version": "1.0.0",
  "description": "Insurance Demo Backend - NestJS with MongoDB",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
